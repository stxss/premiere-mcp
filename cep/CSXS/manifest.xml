<?xml version="1.0" encoding="UTF-8"?>
<!-- MCP QE Helper: CEP companion to the UXP MCP Bridge. Runs ExtendScript (incl. the QE DOM) sent by the MCP server.
     Needed for things UXP can't do yet, e.g. audio transitions. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="dev.premieremcp.qehelper" ExtensionBundleVersion="0.1.0"
  ExtensionBundleName="MCP QE Helper" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="dev.premieremcp.qehelper.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="dev.premieremcp.qehelper.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
          <StartOn>
            <!-- Start in the background when Premiere launches, so the panel doesn't need to be open. -->
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>MCP QE Helper</Menu>
          <Geometry>
            <Size><Height>220</Height><Width>320</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
